use flake

# direnv evaluates the flake non-interactively, so the dev shell's own greeting
# never shows. Print it here instead (stderr is what direnv displays).
if [[ -t 2 && -z "${DIGIKEY_MCP_QUIET:-}" ]]; then
  digikey-mcp welcome >&2 || true
  echo "Help: digikey-mcp --help, digikey-mcp <command> --help" >&2
fi
